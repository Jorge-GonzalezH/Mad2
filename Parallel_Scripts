# Versión mejorada de los tres scripts para lanzar simulaciones en paralelo de forma real y simultánea en el NLHPC Chile
# Cada simulación lanza su propio proceso en segundo plano y se espera al final con wait

# ==== Script 1 ====
#!/bin/bash
#SBATCH -J Simu_GROMACS_mn001
#SBATCH -p general
#SBATCH -n 1
#SBATCH -c 14
#SBATCH --mem-per-cpu=1000
#SBATCH --nodelist=sn023
#SBATCH --mail-user=jfgonzalez5@uc.cl
#SBATCH --mail-type=END,FAIL
#SBATCH -o Sim_GROMACS_mn001_%j.out
#SBATCH -e Sim_GROMACS_mn001_%j.err

module load gromacs/4.5.4-zen4-jdem0r4 > /dev/null 2>&1

temps=("118.0" "120.0" "122.0" "124.0" "126.0" "126.4" "126.8")
base_dir="/home/jgonzalezh/Mad2/SBM/CAlpha/EXP3.2"
cores_per_sim=2

for temp in "${temps[@]}"; do
  (
    temp_str=$(echo $temp | tr '.' '_')
    temp_dir="${base_dir}/run_${temp_str}"

    if [ ! -d "$temp_dir" ]; then
      echo "⚠️  Directorio $temp_dir no existe. Omitiendo..."
      exit
    fi

    echo "🟢 Nodo mn001: Ejecutando T=${temp} K"
    cd "$temp_dir"
    grompp -f mdrun_CA_${temp_str}.mdp -c dualMAD_opened.gro -p dual_FinalT_aligned.top -o run_${temp_str}.tpr -maxwarn 1
    mdrun -s run_${temp_str}.tpr -nt $cores_per_sim -noddcheck -pin on
    echo -e "Protein\nProtein" | gmx trjconv -s run_${temp_str}.tpr -f traj_comp.xtc -o centered.xtc -center -pbc mol -ur compact -n index_C.ndx
    echo -e "0\n0" | gmx rms -s dualMAD_opened.gro -f traj_comp.xtc -xvg none
    echo "Potential" | gmx energy -f ener.edr -xvg none
    echo -e "1\n0" | g_kuh -s dualMAD_opened.gro -f traj_comp.xtc -n contacts_c.ndx -noabscut -noshortcut -cut 0.2 -o qvals_c_ref.out
    paste rmsd.xvg qvals_c_ref.out > data_c_${temp_str}.txt
    echo "1" | g_kuh -s dualMAD_opened.gro -f traj_comp.xtc -n contacts_o.ndx -noabscut -noshortcut -cut 0.2 -o qvals_o_ref.out
    paste rmsd.xvg qvals_o_ref.out > data_o_${temp_str}.txt
    echo -e "Protein\nProtein" | gmx trjconv -s run_${temp_str}.tpr -f traj_comp.xtc -o ${temp_str}_traj_CA_${temp_str}.pdb
    echo "✅ Finalizada T=${temp} K"
  ) &
done
wait

